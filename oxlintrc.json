{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error",
    "suspicious": "error",
    "nursery": "warn"
  },
  "env": {
    "browser": true
  },
  "rules": {
    "max-lines": "allow",
    "max-params": "allow",
    "no-async-await": "allow",
    "no-await-in-loop": "allow",
    "no-continue": "allow",
    "no-magic-numbers": "allow",
    "no-ternary": "allow",
    "no-undefined": "allow",
    "yoda": "allow"
  }
}
